        <main class="main-content">
            <div class="page-header">
                <h1 class="greeting" id="greeting">E-Građevinski dnevnik</h1>
                <p class="greeting-sub">Kako stvari napreduju....</p>
            </div>

            <div class="two-col">
                <div class="form-card">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Kreiraj Novi Unos</h3>
                            <p class="card-subtitle">Popuni ispod detaljnije</p>
                        </div>
                        <form class="dashboard-form" action="/controllers/pages/renderIndex.js" method="post">
                            <div class="form-group">
                                <label for="izvodjac_name">Izvođač radova:</label>
                                <input type="text" id="izvodjac_name" placeholder="Unesi naziv izvođača..." required>
                            </div>
                            <div class="form-group">
                                <label for="objekat_name">Objekat:</label>
                                <input type="text" id="objekat_name" placeholder="Unesi objekat..." required>
                            </div>
                            <div class="form-group">
                                <label for="mesto">Mesto:</label>
                                <input type="text" id="mesto" placeholder="Unesi naziv mesta...">
                            </div>
                            <div class="form-group">
                                <label for="investitor_name">Investitor:</label>
                                <input type="text" id="investitor_name" placeholder="Unesi investitora..." required>
                            </div>
                            <div class="form-group">
                                <label for="dan">Dan:</label>
                                <select id="dan">
                                    <option value="ponedeljak">Ponedeljak</option>
                                    <option value="utorak">Utorak</option>
                                    <option value="sreda">Sreda</option>
                                    <option value="cetvrtak">Četvrtak</option>
                                    <option value="petak">Petak</option>
                                    <option value="subota">Subota</option>
                                    <option value="nedelja">Nedelja</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="datum">Datum:</label>
                                <input type="date" id="datum" required>
                            </div>
                            <div class="form-group">
                                <label for="radno_vreme_start">Radno vreme od:</label>
                                <input type="time" id="radno_vreme_start" onchange="racunajSate()" required>
                            </div>
                            <div class="form-group">
                                <label for="radno_vreme_do">Radno vreme do:</label>
                                <input type="time" id="radno_vreme_do" onchange="racunajSate()" required>
                            </div>
                            <div class="form-group">
                                <label for="podizvodjac_radova_name">Podizvođač radova:</label>
                                <button type="button" class="btn btn-primary">Unesi podizvođača...</button>
                            </div>
                            <div class="form-group">
                                <p id="ispis"></p>
                            </div>
                            <div class="form-group">
                                <label for="opis_posla">Opis posla:</label>
                                <textarea name="opis_posla" id="opis_posla" placeholder="Unesi opis posla..." rows="6"
                                    required></textarea>
                            </div>
                            <div class="form-group">
                                <label for="status_kvara">Status kvara:</label>
                                <select id="status_kvara">
                                    <option value="" selected disabled>Odaberi status...</option>
                                    <option value="potpunosti">Otklonjen u potpunosti</option>
                                    <option value="delimicno">Otklonjen delimično</option>
                                    <option value="nije">Nije otklonjen, neophodni dodatni radovi</option>
                                </select>
                            </div>
                            <div class="btn-row">
                                <button type="submit" class="btn btn-primary">Unesi</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>

        <footer class="footer">
